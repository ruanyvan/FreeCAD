{
    // FreeCAD 1.1 (pixi/conda 构建) 的 VSCode C++ 调试配置。
    //
    // 前提：已完成以下步骤（见 .vscode/tasks.json）：
    //   1. pixi run configure-debug
    //   2. pixi run build-debug
    //   3. pixi run install-debug   <- 把 FreeCAD 安装进 .pixi 依赖环境
    //
    // 调试目标用的是“安装后”的 FreeCAD.exe（位于 conda 环境内，
    // Qt/OCCT/Python 等 DLL 就在其旁边）。虽然 exe 装在 .pixi 里，
    // 但其内嵌的 PDB 绝对路径指回 build/debug，源码断点照常生效。
    // 改完代码后记得重新执行 build + install 再按 F5。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FreeCAD (GUI)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.pixi/envs/default/Library/bin/FreeCAD.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [
                {
                    // 模拟 conda 环境激活：保证 python311.dll 等
                    // （位于环境根目录而非 Library/bin）能被加载器找到
                    "name": "PATH",
                    "value": "${workspaceFolder}/.pixi/envs/default;${workspaceFolder}/.pixi/envs/default/Library/mingw-w64/bin;${workspaceFolder}/.pixi/envs/default/Library/bin;${workspaceFolder}/.pixi/envs/default/Library/lib;${env:PATH}"
                }
            ]
        },
        {
            // 交互式：启动后出现 FreeCADCmd 的 >>> 提示符，可直接敲 Python。
            // console 必须是 integratedTerminal，否则提示符收不到键盘输入。
            "name": "FreeCADCmd(commandline)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.pixi/envs/default/Library/bin/FreeCADCmd.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/.pixi/envs/default;${workspaceFolder}/.pixi/envs/default/Library/mingw-w64/bin;${workspaceFolder}/.pixi/envs/default/Library/bin;${workspaceFolder}/.pixi/envs/default/Library/lib;${env:PATH}"
                }
            ]
        },
        {
            // C++ 原生驱动的调试实验（debug-labs/，实验全程不经过 Python）。
            // 目标在 build/debug/bin；PATH 必须包含 Mod/Part——隐式链接的
            // Part.pyd 靠它解析（上游 tests/CMakeLists.txt 注明模块测试在
            // Windows 上正是缺这一步而无法运行）。
            // 改动 LabsMain.cpp 后需重新 build（无需 install，直接跑构建产物）。
            "name": "FreeCAD Labs (C++)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/bin/FreeCADLabs.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/build/debug/Mod/Part;${workspaceFolder}/build/debug/bin;${workspaceFolder}/.pixi/envs/default;${workspaceFolder}/.pixi/envs/default/Library/mingw-w64/bin;${workspaceFolder}/.pixi/envs/default/Library/bin;${workspaceFolder}/.pixi/envs/default/Library/lib;${env:PATH}"
                }
            ]
        },
        {
            "name": "附加到运行中的 FreeCAD",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
